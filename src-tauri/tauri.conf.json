{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HouseLedger",
  "version": "1.3.0",
  "identifier": "com.frost.houseledger",
  "build": {
    "beforeDevCommand": "npm run react:start",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run react:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "House Ledger",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../build/icons/icon.ico",
      "../build/icons/32x32.png",
      "../build/icons/128x128.png",
      "../build/icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "startMenuFolder": "HouseLedger"
      }
    }
  }
}
