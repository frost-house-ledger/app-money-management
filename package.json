{
  "name": "house-ledger",
  "version": "2.0",
  "description": "Tauri + React personal money management app",
  "author": "Frost",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "react:start": "vite",
    "react:build": "vite build",
    "dev": "npm run tauri:dev",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:x86": "tauri build --target i686-pc-windows-msvc",
    "sync:tauri-version": "node ./scripts/sync-tauri-version.cjs",
    "generate:icons": "node ./scripts/generate-icons.cjs",
    "release": "node ./scripts/release.cjs",
    "dist:win:all": "npm run tauri:build && npm run tauri:build:x86",
    "test": "jest",
    "android:build": "npm run react:build && npx cap copy android && npx cap open android",
    "android:sync": "npm run react:build && npx cap sync android",
    "android:studio": "npm run android:sync && npx cap open android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-sql": "^2",
    "chart.js": "^4.5.1",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "mongodb": "^7.6.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@capacitor/cli": "^8.5.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "tar": ">=7.5.22",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@babel/core": "8.0.1"
  }
}
