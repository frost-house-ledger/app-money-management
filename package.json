{
  "name": "house-ledger",
  "version": "1.3.0",
  "description": "Electron + React personal money management app",
  "author": "Frost",
  "main": "Desktop/electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "react:start": "vite",
    "react:build": "vite build",
    "start": "npm run tauri:dev",
    "dev": "concurrently \"npm run react:start\" \"wait-on tcp:5173 && electron .\"",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "move:exe": "node ./scripts/move-exe.cjs",
    "bring:exe": "npm run move:exe",
    "generate:icons": "node ./scripts/generate-icons.cjs",
    "kill-running": "node ./scripts/kill-running.cjs",
    "release": "node ./scripts/release.cjs",
    "predist:win": "npm run test && npm run generate:icons && npm run kill-running",
    "dist:win": "npm run react:build && electron-builder --publish never --win nsis --x64 && npm run move:exe",
    "predist:win32": "npm run test && npm run generate:icons && npm run kill-running",
    "dist:win32": "npm run react:build && electron-builder --publish never --win nsis --ia32 && npm run move:exe",
    "predist:win:all": "npm run test && npm run generate:icons && npm run kill-running",
    "dist:win:all": "npm run react:build && electron-builder --publish never --win nsis --x64 --ia32 && npm run move:exe",
    "dist:win:all:fast": "npm run tauri:build",
    "test": "jest",
    "predist:mac": "npm run test && npm run generate:icons && npm run kill-running",
    "dist:mac": "npm run react:build && electron-builder --publish never --mac --x64",
    "predist:mac:arm64": "npm run test && npm run generate:icons && npm run kill-running",
    "dist:mac:arm64": "npm run react:build && electron-builder --publish never --mac --arm64",
    "predist:mac:all": "npm run test && npm run generate:icons && npm run kill-running",
    "dist:mac:all": "npm run react:build && electron-builder --publish never --mac --x64 --arm64",
    "predist:dir": "npm run test && npm run generate:icons && npm run kill-running",
    "dist:all": "npm run dist:win:all && echo macOS release files are built in GitHub Actions or on a macOS machine with npm run dist:mac:all",
    "dist:dir": "npm run react:build && electron-builder --dir",
    "android:build": "npm run react:build && npx cap copy android && npx cap open android",
    "android:sync": "npm run react:build && npx cap sync android",
    "android:studio": "npm run android:sync && npx cap open android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.4.2",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-sql": "^2",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "i18next": "^26.4.0",
    "mongodb": "^7.6.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@capacitor/cli": "^8.5.0",
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@tauri-apps/cli": "^2",
    "babel-jest": "^30.4.1",
    "concurrently": "^10.0.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tar": ">=7.5.22",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@babel/core": "8.0.1"
  },
  "build": {
    "appId": "com.frost.houseledger",
    "productName": "HouseLedger",
    "icon": "build/icons/icon",
    "files": [
      "Desktop/electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "executableName": "HouseLedger",
      "artifactName": "HouseLedger-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "mac": {
      "executableName": "HouseLedger",
      "artifactName": "HouseLedger-mac-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "com.frost.houseledger",
      "deleteAppDataOnUninstall": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "HouseLedger"
    },
    "extraMetadata": {
      "main": "Desktop/electron/main.js"
    }
  }
}
